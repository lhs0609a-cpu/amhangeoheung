# Server Configuration
NODE_ENV=development
PORT=3000

# Supabase
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# JWT
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=generate-a-64-byte-hex-string-using-the-command-above
JWT_EXPIRES_IN=7d

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# External APIs
# PASS_API_KEY=
# KAKAO_API_KEY=
# NAVER_API_KEY=

# SMS
# SMS_API_KEY=
# SMS_SENDER=

# TossPayments
# Get test keys: https://developers.tosspayments.com/my/api-keys
TOSS_CLIENT_KEY=test_ck_your_client_key
TOSS_SECRET_KEY=test_sk_your_secret_key

# Email (SMTP)
# Leave SMTP_HOST empty to use dev mode (console log only)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# FROM_EMAIL=noreply@amhangeoheung.com

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000
