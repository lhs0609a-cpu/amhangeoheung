# Server Configuration
NODE_ENV=development
PORT=3000

# Supabase
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# JWT
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=generate-a-64-byte-hex-string-using-the-command-above
JWT_EXPIRES_IN=7d

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# External APIs
# KAKAO_API_KEY=
# NAVER_API_KEY=

# 본인인증 (Identity verification) — 서버측 CI/DI 조회
# 미설정 시 /auth/verify-identity 는 항상 인증을 거부한다 (fail-closed).
# 클라이언트는 인증기관 SDK 로 인증을 마친 뒤 receiptId(예: 아임포트 imp_uid)만
# 서버에 전달하고, 서버가 아래 자격증명으로 CI/DI 를 직접 조회한다.
# IDENTITY_PROVIDER=portone            # 'portone' | 'nice'
# PortOne(아임포트) 본인인증
# PORTONE_API_KEY=
# PORTONE_API_SECRET=
# NICE 본인인증 (자체 호스팅 결과조회 어댑터 경유)
# NICE_VERIFY_URL=
# NICE_VERIFY_TOKEN=

# 영수증 OCR (Google Cloud Vision) — 미설정 시 자동 승인하지 않고 수동검토 큐로 보냄
# GOOGLE_VISION_API_KEY=

# 정산 송금 (Payout) — 미설정 시 성공 반환 없이 관리자 수동 정산으로 hold
# PAYOUT_PROVIDER=                     # 'openbanking' | 'toss' 등
# PAYOUT_API_BASE_URL=
# PAYOUT_API_KEY=

# SMS
# SMS_API_KEY=
# SMS_SENDER=

# TossPayments
# Get test keys: https://developers.tosspayments.com/my/api-keys
TOSS_CLIENT_KEY=test_ck_your_client_key
TOSS_SECRET_KEY=test_sk_your_secret_key

# Email (SMTP)
# Leave SMTP_HOST empty to use dev mode (console log only)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# FROM_EMAIL=noreply@amhangeoheung.com

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000
